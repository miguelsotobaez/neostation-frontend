{
  "categories": [
    {
      "title": "## Features",
      "labels": [
        "feature",
        "enhancement",
        "feat"
      ]
    },
    {
      "title": "## Fixes",
      "labels": [
        "fix",
        "bug"
      ]
    },
    {
      "title": "## Maintenance",
      "labels": [
        "chore",
        "refactor",
        "docs",
        "style",
        "ci",
        "perf",
        "test",
        "revert"
      ]
    },
    {
      "title": "## Dependencies",
      "labels": [
        "dependencies"
      ]
    },
    {
      "title": "## Other",
      "labels": []
    }
  ],
  "label_extractor": [
    {
      "pattern": "^(feat|fix|docs|style|refactor|perf|test|chore|ci|revert)(\\([^)]*\\))?(!)?:[\\s\\S]*$",
      "target": "$1",
      "on_property": "title",
      "flags": "gu"
    },
    {
      "pattern": "^build\\(deps[^)]*\\)(!)?:[\\s\\S]*$",
      "target": "dependencies",
      "on_property": "title",
      "flags": "gu"
    }
  ],
  "sort": "ASC",
  "template": "${{CHANGELOG}}\n\n**Full Changelog**: ${{RELEASE_DIFF}}",
  "pr_template": "- ${{TITLE}} (#${{NUMBER}}) @${{AUTHOR}}",
  "empty_template": "- No changes",
  "max_pull_requests": 100,
  "max_back_track_time_days": 365
}
